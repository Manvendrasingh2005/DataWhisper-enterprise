# ==========================================
# DataWhisper Backend Environment Variables
# ==========================================

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Django Secret Key (Set a strong key in production)
SECRET_KEY=your-fallback-local-secret-key

# Database URL (Optional: switches to PostgreSQL when provided, otherwise defaults to sqlite:///db.sqlite3)
# Example: postgresql://postgres:password@localhost:5432/datawhisper
# DATABASE_URL=sqlite:///db.sqlite3

# Test Runner Credentials (Used by test_api.py)
TEST_USERNAME=admin
TEST_PASSWORD=adminpassword123
